{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "#components": ["src/components/index.js"],
      "#components/*": ["src/components/*"],
      "#constants": ["src/constants/index.js"],
      "#constants/*": ["src/constants/*"],
      "#store": ["src/store/index.js"],
      "#store/*": ["src/store/*"],
      "#hooks": ["src/hooks/index.js"],
      "#hooks/*": ["src/hooks/*"],
      "#assets/*": ["src/assets/*"]
    },
    "jsx": "react-jsx"
  },
  "include": ["src"]
}
